{
 "format": "doorprints-drive-vectors/1",
 "note": "Shared by android/shared DriveVectorsTest and web drive-vectors.spec.ts (docs/schemas/README.md section 6.2, S4b-BL-115): Drive v3's q strings, request and answer shapes, the error mapping and the backoff rule must be the same on both stacks. Content byte i of an upload is (i * 31 + seed) mod 251. Tokens come from a provider that gives token-1, then token-2 after a rejection. Waits use random 0.5.",
 "queries": [
  {
   "name": "the root folder anywhere",
   "query": {
    "appProperties": {
     "doorprints": "root"
    },
    "mimeType": "application/vnd.google-apps.folder"
   },
   "q": "mimeType = 'application/vnd.google-apps.folder' and appProperties has { key='doorprints' and value='root' } and trashed = false"
  },
  {
   "name": "finished backups in the Backups folder",
   "query": {
    "parentId": "fBackups",
    "appProperties": {
     "state": "complete",
     "kind": "backup"
    }
   },
   "q": "'fBackups' in parents and appProperties has { key='kind' and value='backup' } and appProperties has { key='state' and value='complete' } and trashed = false"
  },
  {
   "name": "app properties go in key order",
   "query": {
    "parentId": "fSync",
    "appProperties": {
     "state": "partial",
     "kind": "sync",
     "device": "d1"
    },
    "trashed": true
   },
   "q": "'fSync' in parents and appProperties has { key='device' and value='d1' } and appProperties has { key='kind' and value='sync' } and appProperties has { key='state' and value='partial' } and trashed = true"
  },
  {
   "name": "quotes and backslashes are escaped",
   "query": {
    "name": "it's a \\ test",
    "trashed": false
   },
   "q": "name = 'it\\'s a \\\\ test' and trashed = false"
  },
  {
   "name": "the bin too when trashed is null",
   "query": {
    "parentId": "p1",
    "trashed": null
   },
   "q": "'p1' in parents"
  },
  {
   "name": "nothing but the bin rule",
   "query": {},
   "q": "trashed = false"
  }
 ],
