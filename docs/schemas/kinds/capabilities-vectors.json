 "today": {
  "huntAlertRadiusM": 30,
  "huntAlertRadiusMSource": "AppSettings.alertRadiusM default (android/shared Settings.kt); Hunt's radius setting is 15..100 m and stays the house's own override; a kind's file value is the default for every other kind (kinds PR 26)",
  "compareCriteriaAre": "the checklist keys (web CHECKLIST, android Checklist.keys), in order",
  "contactsFollow": "the broker field: the house shows `brokerId` and makes a broker from a phone (BrokerStore.linked), the school shows no broker and makes none; since kinds PR 29 the rule is `contacts.autoCreateFromPhone` and the broker field is shown only where `contacts.role` is `broker`",
  "sectionsFollow": {
   "rooms": "rooms",
   "moveIn": "moveIn",
   "viewings": "viewings",
   "questions": "viewings",
   "paths": "walks"
  }
 },
