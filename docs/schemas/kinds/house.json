  { "id": "noticeMonths", "type": "number", "integer": true, "min": 0, "max": 120, "unit": "month", "section": "cost", "order": 80, "was": "cost.noticeMonths", "label": { "web": "cost.noticeMonths", "android": "house_notice" } },
  { "id": "availableFrom", "type": "date", "section": "cost", "order": 90, "was": "cost.availableFrom", "label": { "web": "cost.availableFrom", "android": "house_available_from" } },
