  { "id": "depositMonths", "type": "number", "integer": true, "min": 0, "max": 120, "unit": "month", "section": "cost", "order": 20, "was": "cost.depositMonths", "label": { "web": "cost.depositMonths", "android": "house_deposit_months" } },
  { "id": "maintenance", "type": "money", "max": 1000000000000, "cadences": ["month"], "section": "cost", "order": 30, "was": "cost.maintenance", "label": { "web": "cost.maintenance", "android": "house_maintenance" } },
  { "id": "maintenanceIncluded", "type": "bool", "section": "cost", "order": 40, "was": "cost.maintenanceIncluded", "label": { "web": "cost.maintenanceIncluded", "android": "house_maintenance_included" } },
