<!--
    Doorprints launcher icon: an arched front door with a doorstep, and three footprints walking up beside it,
    left, right, left. Each print is a sole, a heel and four toes (big toe on the inner side), drawn once as a right foot around (0,0)
    and placed by its group: scale 0.9 (mirrored for the left foot), rotate -10, then translate. Option C of
    docs/14 N3. The web icons (web/public/favicon.svg and web/public/icons/*.png) are the same mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#1F6F5C" android:pathData="M0,0h108v108h-108z" />
    <!-- Door with arched top, and the doorstep below it -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M32,82 L32,42 A14,14 0 0,1 60,42 L60,82 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M28,84h36v4h-36z" />
    <!-- Door knob -->
    <path android:fillColor="#1F6F5C"
        android:pathData="M51.5,64 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
    <!-- Nearest the step: left foot -->
    <group android:translateX="78" android:translateY="80" android:rotation="-10"
        android:scaleX="-0.9" android:scaleY="0.9">
        <path android:fillColor="#F2B84B"
            android:pathData="M-2.7,-1.6 a2.7,3.9 0 1,0 5.4,0 a2.7,3.9 0 1,0 -5.4,0 Z M-1.7,4.6 a2,2.4 0 1,0 4,0 a2,2.4 0 1,0 -4,0 Z M-2.9,-7.45 a0.95,0.95 0 1,0 1.9,0 a0.95,0.95 0 1,0 -1.9,0 Z M-0.9,-7.6 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M0.8,-7.1 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z M2.2,-6.35 a0.65,0.65 0 1,0 1.3,0 a0.65,0.65 0 1,0 -1.3,0 Z" />
    </group>
    <!-- Middle: right foot -->
    <group android:translateX="84" android:translateY="68" android:rotation="-10"
        android:scaleX="0.9" android:scaleY="0.9">
        <path android:fillColor="#F2B84B"
            android:pathData="M-2.7,-1.6 a2.7,3.9 0 1,0 5.4,0 a2.7,3.9 0 1,0 -5.4,0 Z M-1.7,4.6 a2,2.4 0 1,0 4,0 a2,2.4 0 1,0 -4,0 Z M-2.9,-7.45 a0.95,0.95 0 1,0 1.9,0 a0.95,0.95 0 1,0 -1.9,0 Z M-0.9,-7.6 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M0.8,-7.1 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z M2.2,-6.35 a0.65,0.65 0 1,0 1.3,0 a0.65,0.65 0 1,0 -1.3,0 Z" />
    </group>
    <!-- Furthest: left foot -->
    <group android:translateX="78.5" android:translateY="51.5" android:rotation="-10"
        android:scaleX="-0.9" android:scaleY="0.9">
        <path android:fillColor="#F2B84B"
            android:pathData="M-2.7,-1.6 a2.7,3.9 0 1,0 5.4,0 a2.7,3.9 0 1,0 -5.4,0 Z M-1.7,4.6 a2,2.4 0 1,0 4,0 a2,2.4 0 1,0 -4,0 Z M-2.9,-7.45 a0.95,0.95 0 1,0 1.9,0 a0.95,0.95 0 1,0 -1.9,0 Z M-0.9,-7.6 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M0.8,-7.1 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z M2.2,-6.35 a0.65,0.65 0 1,0 1.3,0 a0.65,0.65 0 1,0 -1.3,0 Z" />
    </group>
</vector>
