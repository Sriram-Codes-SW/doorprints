    <path android:fillColor="#FFFFFF"
        android:pathData="M32,82 L32,42 A14,14 0 0,1 60,42 L60,82 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M28,84h36v4h-36z" />
