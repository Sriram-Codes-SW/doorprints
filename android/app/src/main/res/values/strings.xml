<!-- English (default): strings of the Android services (notifications, workers, the hunt service, SAF) and the
     manifest. The UI strings are Compose Multiplatform resources in android/ui/src/commonMain/composeResources
     (ADR-23 CMP-2). The workers read the Compose resources too (S4b-BL-106); a key is in both places only where
     Android code reads it at once, outside a coroutine (the manifest, the hunt service, the share and open
     choosers), with the same text (StringParityTest). -->
<resources>
    <!-- The language of this folder: AppLocale.applyDefault reads it to learn which one Android chose. -->
    <string name="resolved_language">en</string>
    <string name="app_name">Doorprints</string>
    <string name="common_score_value">Score %1$s</string>
    <string name="status_NEW">New</string>
    <string name="status_SHORTLISTED">Shortlisted</string>
    <string name="status_REJECTED">Rejected</string>
    <string name="status_TAKEN">Taken</string>
    <string name="status_NOT_CHOSEN">Not chosen</string>
    <string name="notif_channel_hunt">Hunt mode</string>
    <string name="notif_channel_hunt_desc">Shown while Doorprints is tracking your walk</string>
    <string name="notif_channel_alerts">House and street alerts</string>
    <string name="notif_channel_alerts_desc">When you pass a house or street you have visited before</string>
    <string name="notif_hunt_title">Hunt mode is on</string>
    <string name="notif_hunt_text">Watching for houses and streets you have visited</string>
    <!-- Wave D (2026-10-01): a notification action names what it does, as TalkBack reads it alone (S4b-BL-94b). -->
    <string name="notif_stop">Stop Hunt mode</string>
    <string name="notif_seen_house">You have seen this one: %1$s</string>
    <string name="notif_distance">%1$s · %2$d m away</string>
    <string name="notif_visited_before">Visited before</string>
    <string name="notif_street_title">You have been on %1$s before</string>
    <string name="notif_street_text">Saved houses: %1$d, visits: %2$d</string>
    <string name="notif_street_text_since">Saved houses: %1$d, visits: %2$d, first on %3$s</string>
    <string name="notif_stay_title">Are you at a house?</string>
    <string name="notif_stay_text">You have been here a few minutes. Tap to save it with notes and photos.</string>
    <string name="notif_public">Doorprints alert</string>
    <string name="notif_battery_title">Hunt mode stopped</string>
    <string name="notif_battery_text">Battery is low (%1$d%%). Turn hunt mode on again when charging.</string>
    <!-- Offline copy: export, import and automatic backup (Sprint 4a, S4-02/S4-04/S4-07) -->
    <string name="notif_channel_export">Saving and importing</string>
    <string name="notif_channel_export_desc">Shown while a copy is being saved or a backup is being read</string>
    <string name="export_share">Share</string>
    <string name="export_open">Open</string>
    <string name="export_notif_saved">Your copy is saved</string>
    <string name="export_notif_ready">Your copy is ready to share</string>
    <string name="export_notif_failed">The copy could not be saved</string>
    <string name="import_notif_done">Backup imported</string>
    <string name="import_notif_failed">The backup could not be imported</string>
    <string name="auto_backup_stopped_title">Automatic backup stopped</string>
    <string name="auto_backup_stopped_text">The folder is no longer available. Tap to choose it again.</string>
    <string name="auto_backup_failed_title">Automatic backup did not work</string>
    <string name="export_location_downloads">Downloads</string>
    <string name="price_per_month">%1$s/month</string>
    <!-- Slice 3b-2, viewing reminders (2026-09-30). -->
    <string name="notif_channel_viewings">Viewing reminders</string>
    <string name="notif_channel_viewings_desc">Before a viewing you have planned</string>
    <string name="notif_viewing_soon">Viewing at %1$s in %2$d min</string>
