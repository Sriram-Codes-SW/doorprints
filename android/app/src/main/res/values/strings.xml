    <string name="notif_viewing_open">Open house</string>
    <!-- Wave D (2026-10-01): a notification action names what it does, as TalkBack reads it alone (S4b-BL-94b). -->
    <string name="notif_viewing_directions">Directions to the house</string>
    <!-- Wave D (2026-10-01): a notification action names what it does, as TalkBack reads it alone (S4b-BL-94b). -->
    <string name="notif_viewing_questions">Questions to ask</string>
    <string name="notif_viewing_house_gone">a house that is gone</string>
    <!-- Slice 3c, the Hunt mode reminder (2026-09-30). -->
    <string name="notif_channel_hunt_reminders">Hunt mode reminders</string>
    <string name="notif_channel_hunt_reminders_desc">Offers Hunt mode before a viewing</string>
    <string name="notif_hunt_reminder">Viewing at %1$s in %2$d min. Start Hunt mode?</string>
    <string name="notif_hunt_reminder_start">Start Hunt mode</string>
    <!-- Wave D (2026-10-01): a notification action names what it does, as TalkBack reads it alone (S4b-BL-94b). -->
    <string name="notif_hunt_reminder_dismiss">Dismiss reminder</string>
    <!-- Slice 4b, the area wake-up (2026-09-30). -->
    <string name="notif_channel_area_wakeup">Area wake-up</string>
    <string name="notif_channel_area_wakeup_desc">Offers Hunt mode when you arrive in one of your hunting areas</string>
    <string name="notif_area_wakeup">You\'re in %1$s. Start Hunt mode?</string>
    <!-- Wave D (2026-10-01): the notifications' own action names, which say what they act on (S4b-BL-94b). -->
    <string name="notif_copy_open">Open the copy</string>
    <string name="notif_copy_share">Share the copy</string>
    <string name="notif_task_stop">Stop this task</string>
</resources>
