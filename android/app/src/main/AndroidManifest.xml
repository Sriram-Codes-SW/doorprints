<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The area wake-up's geofences (docs/11 5.17, 5.18, slice 4b): "Allow all the time". Only requested when the
         person turns *Wake me in my hunting areas* on, after the in-app rationale screen; never at first launch. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- A long export, import or automatic backup runs as a WorkManager foreground job (Sprint 4a, S4-02), so
         Android does not stop it halfway while the user looks at something else. Android 14+ requires the
         type-specific permission as well as the generic FOREGROUND_SERVICE one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Viewing reminders (docs/11 5.8, 5.16): exact alarms when the person allows "Alarms & reminders" (never asked
         at start-up; Settings > Viewings has the optional link), otherwise a 10-minute window alarm. Not
         USE_EXACT_ALARM, which Play limits to alarm-clock and calendar apps. The alarms are set again after a boot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".DoorprintsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doorprints"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- doorprints://connect?server=…&invite=… from the server's owner page (its QR code, docs/03 §12.1).
                 Checked by ConnectLink.parse, and the app asks before connecting: any app or page can send one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doorprints" android:host="connect" />
            </intent-filter>
            <!-- A backup or update file opened in Doorprints (docs/11 5.28, S4b-FR-3): "open with" from a file app or
                 a chat's attachment (VIEW), or "share to Doorprints" (SEND). ZIP and JSON, the two forms a backup
                 takes; the Import screen validates the file as any picked one and refuses anything else. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- A listing shared as text from a portal's app or a browser (docs/11 5.29, 5.9: "Add a shared listing").
                 The text is parsed on the device; the listing page is never fetched. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The launcher entry. Its name is the activity's class name from before the package rename of 2026-09-24,
             a stored identifier kept on purpose: launchers remember an app icon placed on the home screen by this
             component name, and a new name would silently remove that icon on update. It opens MainActivity. -->
        <activity-alias
            android:name="com.househunt.app.MainActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".location.HuntService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- A viewing reminder's alarm (slice 3b-2): reached only through this app's own immutable PendingIntent. -->
        <receiver
            android:name=".ViewingReminderReceiver"
            android:exported="false" />

        <!-- Sets every viewing reminder again after a boot, a clock or time-zone change, an app update and the grant of
             "Alarms & reminders". Not exported on purpose: these broadcasts come from the system, which reaches a
             non-exported receiver; no other app has any reason to trigger a reschedule. -->
        <receiver
            android:name=".ViewingReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The area wake-up (slice 4b): geofence events, the notification's Dismiss, and after a boot or an app update the
             geofences set again. Not exported: the geofencing PendingIntent is explicit to this receiver and mutable
             only because the Geofencing API requires it (Play services fills in the event's extras); the Dismiss
             PendingIntent is immutable; the two system broadcasts reach a non-exported receiver. -->
        <receiver
            android:name=".AreaGeofenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's own foreground service needs a declared type from Android 14 (API 34): it is merged
             into the library's <service> entry rather than declared again. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- WorkManager starts on demand with DoorprintsApp.workManagerConfiguration (LegacyWorkerFactory) instead of
             its default start-up initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
