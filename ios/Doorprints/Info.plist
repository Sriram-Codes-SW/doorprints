<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Doorprints iOS app's Info.plist (CMP-8b), written by hand; project.yml points INFOPLIST_FILE here and turns
  Xcode's generated plist off. The $(...) values are build settings from project.yml. No NSAppTransportSecurity
  exceptions: ATS refuses plain http:// to a domain name; a server on a LAN IP address or a .local name is not covered
  by ATS, so it connects without TLS, as on Android, and iOS first asks for local network access (the purpose string
  below). The purpose strings are localised in <lang>.lproj/InfoPlist.strings.
-->
<plist version="1.0">
<dict>
	<!-- doorprints://connect?server=…&invite=… from the owner page's QR code (docs/03 §12.1). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.doorprints.connect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>doorprints</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hi</string>
		<string>ta</string>
		<string>te</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Doorprints</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Compose Multiplatform needs this to draw at 120 Hz on ProMotion iPhones. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- A plain launch screen (the system background); Compose draws the first frame. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSFaceIDUsageDescription</key>
	<string>Doorprints uses Face ID to unlock the app when the app lock is on.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Doorprints uses your location to place the houses you save and to plan visits from where you are.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Doorprints connects to your own Doorprints server when it is on your local network.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
