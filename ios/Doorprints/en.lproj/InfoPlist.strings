/* The location purpose string iOS shows when Doorprints first asks for location (CMP-8b). It names only what the
   iOS app has from the start (placing a saved house, planning visits from here; Hunt mode is hidden on iOS at first,
   docs/10 §13.11), in the words of the app's own strings (android/ui composeResources: house_use_location,
   ai_plan_location_off). Keep Info.plist's English value the same. */
"NSLocationWhenInUseUsageDescription" = "Doorprints uses your location to place the houses you save and to plan visits from where you are.";

/* Shown when Doorprints first reaches a server on the local network (a LAN IP address or a .local name, CMP-8b).
   Keep Info.plist's English value the same. */
"NSLocalNetworkUsageDescription" = "Doorprints connects to your own Doorprints server when it is on your local network.";
