{
  "spec": "android/shared/src/commonTest/kotlin/app/doorprints/shared/ai/ContactRedactorTest.kt",
  "gradle": [
    ":shared:testAndroidHostTest",
    "--tests",
    "app.doorprints.shared.ai.ContactRedactorTest"
  ],
  "mutations": [
    {
      "file": "android/shared/src/commonMain/kotlin/app/doorprints/shared/ai/ContactRedactor.kt",
      "find": "EMAIL_LIKE.replace(replaceInDigits(PHONE_LIKE, out), EMAIL)",
      "replace": "replaceInDigits(PHONE_LIKE, out)",
      "expect": "emailAddressesAreRemovedWholeBeforeTheNameParts"
    },
    {
      "file": "android/shared/src/commonMain/kotlin/app/doorprints/shared/ai/ContactRedactor.kt",
