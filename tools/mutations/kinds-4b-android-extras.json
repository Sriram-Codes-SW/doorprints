    "--tests",
    "app.doorprints.shared.export.ImportVectorsTest",
    "--tests",
    "app.doorprints.shared.export.BackupFieldsTest"
  ],
  "mutations": [
    {
      "file": "android/shared/src/commonMain/kotlin/app/doorprints/shared/export/BackupWire.kt",
      "find": "        if (other.isNotEmpty()) out[\"extrasOther\"] = JsonObject(other)\n",
