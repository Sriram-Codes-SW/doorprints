    },
    {
      "file": "android/shared/src/commonMain/kotlin/app/doorprints/data/ExportMappers.kt",
      "find": "    extrasOther = Candidates.cleanOtherExtras(extrasOther),",
      "replace": "    extrasOther = null,",
      "expect": "aNewerAppsExtrasAreKeptThroughTheStoreAndWrittenBack"
