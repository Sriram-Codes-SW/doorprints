{
  "spec": "DraftSanitizerTest, ParityVectorsTest",
  "maven": [
    "-Dtest=DraftSanitizerTest,ParityVectorsTest"
  ],
  "mutations": [
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/KindDraftSanitizer.java",
      "find": "if (links >= 2) warnings",
      "replace": "if (links > 2) warnings",
      "expect": "warnsWhenTheTextHasSeveralLinksAndTheDraftHasOne"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/KindDraftSanitizer.java",
      "find": "if (links >= 2) warnings",
      "replace": "if (links >= 1) warnings",
      "expect": "warnsWhenTheTextHasSeveralLinksAndTheDraftHasOne"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/KindDraftSanitizer.java",
      "find": "\"listingUrl: the text has \" + links + \" links",
      "replace": "\"listingUrl: the text has \" + (links + 1) + \" links",
      "expect": "warnsWhenTheTextHasSeveralLinksAndTheDraftHasOne"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/KindDraftSanitizer.java",
      "find": "if (url != null) {\n            var links",
      "replace": "if (url == null) {\n            var links",
      "expect": "warnsWhenTheTextHasSeveralLinksAndTheDraftHasOne"
    },
    {
