      "expect": "theServerGivesTheRecordedAnswers"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/DraftSanitizer.java",
      "find": "LINK_TAIL = \".,;:!?*\";",
      "replace": "LINK_TAIL = \".,;:!?\";",
      "expect": "theServerGivesTheRecordedAnswers"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/DraftSanitizer.java",
      "find": "if (end > link.indexOf(\"//\") + 2)",
      "replace": "if (end > 0)",
      "expect": "theServerGivesTheRecordedAnswers"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/DraftSanitizer.java",
      "find": "Pattern.compile(\"https?://[A-Za-z0-9",
      "replace": "Pattern.compile(\"https://[A-Za-z0-9",
      "expect": "theServerGivesTheRecordedAnswers"
    }
  ]
}
