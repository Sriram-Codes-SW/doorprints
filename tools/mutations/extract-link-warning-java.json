      "find": "var links = DraftSanitizer.linkCount(source);",
      "replace": "var links = DraftSanitizer.linkCount(source + (raw.get(\"notes\") == null ? \"\" : raw.get(\"notes\")));",
      "expect": "countsThePastedTextNotTheLinksTheModelWroteInTheNotes"
    },
    {
