      "expect": "aListingOfEightThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/extract/ListingExtractionService.java",
      "find": "text == null || text.isBlank()",
      "replace": "text == null",
      "expect": "aListingOfEightThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/web/AiController.java",
      "find": "@Size(max = 20000)",
      "replace": "@Size(max = 20001)",
      "expect": "theExtractEndpointRefuses"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/config/AiProperties.java",
      "find": "positiveOr(maxStops, 8)",
      "replace": "positiveOr(maxStops, 9)",
