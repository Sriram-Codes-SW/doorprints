    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/config/AiProperties.java",
      "find": "Math.min(positiveOr(maxStops, 8), 25)",
      "replace": "Math.min(positiveOr(maxStops, 8), 26)",
