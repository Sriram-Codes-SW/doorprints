    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/PromptSafety.java",
      "find": "Character.isHighSurrogate(s.charAt(max - 1)) &&",
      "replace": "false &&",
      "expect": "NeverLeavesHalfOfAnEmoji"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/PromptSafety.java",
      "find": "s.substring(0, splits ? max - 1 : max)",
      "replace": "s.substring(0, splits ? max - 2 : max)",
      "expect": "NeverLeavesHalfOfAnEmoji"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/PromptSafety.java",
      "find": "s.substring(0, splits ? max - 1 : max)",
      "replace": "s.substring(0, max)",
      "expect": "NeverLeavesHalfOfAnEmoji"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/config/AiProperties.java",
