    "-Dtest=AiLimitsTest"
  ],
  "mutations": [
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/rag/HouseDocuments.java",
      "find": "static final int NOTES_MAX = 3000;",
      "replace": "static final int NOTES_MAX = 3001;",
      "expect": "aHouseDocumentCutsNotesAtThreeThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/rag/HouseDocuments.java",
      "find": "notes.length() > NOTES_MAX ?",
      "replace": "notes.length() >= NOTES_MAX ?",
      "expect": "aHouseDocumentCutsNotesAtThreeThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/rag/HouseDocuments.java",
      "find": "+ \" …\" : notes",
      "replace": "+ \"…\" : notes",
      "expect": "aHouseDocumentCutsNotesAtThreeThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/agent/HouseQueries.java",
      "find": "static final int NOTES_MAX = 2000;",
      "replace": "static final int NOTES_MAX = 2001;",
      "expect": "aToolResultCutsNotesAtTwoThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/agent/HouseQueries.java",
      "find": "h.notes().length() <= NOTES_MAX",
      "replace": "h.notes().length() < NOTES_MAX",
      "expect": "aToolResultCutsNotesAtTwoThousand"
    },
    {
      "file": "backend/src/main/java/app/doorprints/server/ai/PromptSafety.java",
