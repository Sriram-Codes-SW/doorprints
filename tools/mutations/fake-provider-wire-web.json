      "expect": "does not follow a redirect"
    },
    {
      "file": "web/src/app/core/ai/openai-compat.ts",
      "find": "const TIER_1_WORDS = ['response_format', 'json_schema', 'strict', 'unsupported', 'not supported'];",
      "replace": "const TIER_1_WORDS = ['zzz'];",
      "expect": "moves the ladder from json_schema to json_object"
