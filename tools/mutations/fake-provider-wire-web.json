{
  "spec": "web/src/app/core/ai/fake-provider.wire.spec.ts",
  "mutations": [
    {
      "file": "web/src/app/core/ai/openai-compat.ts",
      "find": "{ Authorization: `Bearer ${this.apiKey.trim()}` }",
      "replace": "{ Authorization: `Token ${this.apiKey.trim()}` }",
      "expect": "answers a strict json_schema request on the first tier"
    },
    {
      "file": "web/src/app/core/ai/anthropic.ts",
      "find": "'x-api-key': key,",
      "replace": "'x-key': key,",
      "expect": "forces the tool and sends the documented headers"
    },
    {
      "file": "web/src/app/core/ai/anthropic.ts",
      "find": "body['tool_choice'] = { type: 'tool', name };",
      "replace": "body['tool_choice'] = { type: 'auto', name };",
      "expect": "forces the tool and sends the documented headers"
    },
    {
      "file": "web/src/app/core/ai/ai-request.ts",
      "find": "redirect: 'error',",
