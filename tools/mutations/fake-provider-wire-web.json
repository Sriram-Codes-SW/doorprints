    {
      "file": "web/src/app/core/ai/on-device-ai.service.ts",
      "find": "{ headers: { 'x-goog-api-key': this.key } }",
      "replace": "{ headers: { 'x-goog-key': this.key } }",
      "expect": "sends the key in x-goog-api-key"
    },
    {
      "file": "web/src/app/core/ai/anthropic.ts",
      "find": "if (message === null || message['stop_reason'] === 'max_tokens' || !Array.isArray",
      "replace": "if (message === null || !Array.isArray",
