# Security headers for Cloudflare Pages and Netlify (both read this file from the build output).
# Threat model F-10 / SEC-012. GitHub Pages cannot set headers; see docs/07-secure-build-and-deploy.md.
#
# CSP notes:
# - script-src 'self': the production build has no inline scripts (angular.json sets inlineCritical: false,
#   which would otherwise add an inline onload handler).
# - style-src 'unsafe-inline': Angular injects component styles as <style> elements at runtime.
# - connect-src https: : the API address is chosen by the user at runtime, so any HTTPS origin is allowed;
#   http://localhost is for a local API during development. Tiles (OpenFreeMap) and Nominatim are HTTPS.
# - worker-src/child-src blob: : MapLibre GL 5 starts its web worker from a blob: URL.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# index.html must always be revalidated so a new deploy is picked up; hashed bundles can be cached for a year.
/index.html
  Cache-Control: no-cache
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
