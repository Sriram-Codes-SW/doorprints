{
  "name": "Doorprints",
  "short_name": "Doorprints",
  "description": "Remember every house you've seen. Save, rate and compare the houses you visit — on your own device, with no account.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f6f5c",
  "theme_color": "#1f6f5c",
